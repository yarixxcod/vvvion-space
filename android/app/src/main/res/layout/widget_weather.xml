<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="14dp" android:gravity="center_vertical" android:background="@drawable/widget_bg">
    <TextView android:id="@+id/w_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Погода · Алматы" android:textSize="11sp" android:textColor="#FFC4B5E8" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/w_temp" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="−1°" android:textSize="36sp" android:textColor="#FFF4F2EE" android:maxLines="1" android:ellipsize="end" android:fontFamily="sans-serif-light"/>
    <TextView android:id="@+id/w_cond" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="🌤 Преимущественно ясно" android:textSize="13sp" android:textColor="#FFF4F2EE" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/w_hilo" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="↑ 3°  ↓ −2°  ·  ощущается −3°" android:textSize="12sp" android:textColor="#FFB0ADA6" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="2dp"/>
    <TextView android:id="@+id/w_upd" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="обновлено 20:31" android:textSize="10sp" android:textColor="#FF9A958C" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="4dp"/>
</LinearLayout>
