POSTGRES_PASSWORD=change-me
# Один и тот же секрет после каждой пересборки. Если сменить — все выйдут из аккаунтов, сами аккаунты останутся.
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=https://vvvion.space
BETTER_AUTH_TRUSTED_ORIGINS=https://vvvion.space,https://vvvion-space.grok.me
APP_PORT=8080
XAI_API_KEY=
# SMTP Resend. Пусто — письма не отправляются. Ключ только в окружении сервера.
# EMAIL_FROM нужен после подтверждения домена, иначе письма уходят только владельцу ключа.
RESEND_API_KEY=
EMAIL_FROM=VVVION SPACE <no-reply@vvvion.space>
# Push при закрытом приложении. JSON ключа сервисного аккаунта Firebase — лучше в base64.
# Мне и в чат этот файл не отправлять.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=space-vvvion-app
CRON_SECRET=
# Секрет для /api/push/cron (Vercel подставляет Authorization: Bearer сам, если задан CRON_SECRET).
CRON_SECRET=
TINYFISH_API_KEY=
